{
  "name": "crate-social",
  "productName": "Crate",
  "version": "0.1.0",
  "description": "Social media manager for DJs and producers: organise camera footage, export for every platform, plan posts and get content ideas.",
  "main": "./out/main/index.js",
  "author": "Silkie86",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "ffmpeg-static": "5.3.0",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.7.7",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
